# Block script execution in uploads directory
Options -Indexes -ExecCGI
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|phps|cgi|pl|exe|sh|py|jsp|asp|aspx|bat|cmd)$">
    <IfModule authz_core_module>
        Require all denied
    </IfModule>
    <IfModule !authz_core_module>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>
